# ============================================================
# PayNex — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
VITE_APP_NAME=PayNex
VITE_APP_ENV=development

# --- Backend API ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Supabase ---
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Gemini AI ---
# NOTE: Keep your Gemini API key on the BACKEND only.
# Do NOT expose it in frontend variables.
# GEMINI_API_KEY=your_gemini_api_key   <-- backend .env only

# --- PayPal ---
# NOTE: Keep PayPal secrets on the BACKEND only.
# PAYPAL_CLIENT_ID=your_paypal_client_id       <-- backend .env only
# PAYPAL_CLIENT_SECRET=your_paypal_secret      <-- backend .env only
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_public
