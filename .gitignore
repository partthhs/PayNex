# ============================================================
# PayNex — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build outputs ---
dist/
dist-ssr/
build/
*.local

# --- Environment files (NEVER commit these) ---
.env
.env.local
.env.*.local

# --- Vite ---
vite.config.js.timestamp-*

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
*.egg
pip-selfcheck.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS ---
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# --- Testing ---
coverage/
.nyc_output/
