# ============================================================
# PayNex Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
APP_NAME=PayNex
APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Local: postgresql://USERNAME:PASSWORD@localhost:5432/paynex
# Render/Supabase: get connection string from your hosting dashboard
DATABASE_URL=postgresql://paynex:paynex123@localhost:5432/paynex

# --- JWT Secret ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# --- Frontend URL (for CORS and PayPal redirect) ---
FRONTEND_URL=http://localhost:5173

# --- Google Gemini AI ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- PayPal Sandbox ---
# Get from: https://developer.paypal.com > My Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
